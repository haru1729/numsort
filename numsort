import sys
import argparse

def read_data(items):
	line = sys.stdin.readline().strip()
	if not line:
		sys.stderr.write("エラー：入力データが空です\n")
		sys.exit(1)

	items = line.split()
	
	return items

def sort_nums(items):
	try:
		items.sort(key=float)
	except ValueError:
		sys.stderr.write("エラー：数値以外のデータが含まれています\n")
		sys.exit(1)
		
	return items

def main():
	items = []

	items = read_data(items)
	items = sort_nums(items)

	print(" ".join(items))

	return

if __name__ == "__main__":
	main()
