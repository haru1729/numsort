import sys
import math

def read_data():
	line = sys.stdin.readline().strip()
	if not line:
		sys.stderr.write("エラー：入力データが空です\n")
		sys.exit(1)

	items = line.split()
	
	return items

def sort_nums(items):
	try:
		for x in items:
			if not math.isfinite(float(x)):
				raise OverflowError
		items.sort(key=float)

	except ValueError:
		sys.stderr.write("エラー：数値以外のデータが含まれています\n")
		sys.exit(1)
	except OverflowError:
		sys.stderr.write("エラー：NANやINFは扱えません\n")
		sys.exit(1)

	return items

def main():
	items = read_data()
	items = sort_nums(items)

	print(" ".join(items))

if __name__ == "__main__":
	main()
