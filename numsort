import sys
import math
import argparse

#例外処理モジュール化用のクラス
class NumSortError(Exception):
	pass

def parse_args():
	parser = argparse.ArgumentParser(prog="numsort", description="標準入力から受け取った数値をソートします")

	parser.add_argument("-r", "--reverse", action="store_true", help="数値を降順でソート")
	parser.add_argument("-d", "--delimiter", type=str, default=None, help="出力の区切り文字の指定")

	return parser.parse_args()

def read_data():
	line = sys.stdin.readline().strip()
	if not line:
		raise NumSortError("入力データが空です\n")

	#区切り文字の判別
	if ';' in line and ',' in line:
		raise NumSortError("区切り文字が統一されていません\n")

	if ';' in line:
		sep = ';'
		out_sep = ';'

	elif ',' in line:
		sep = ','
		out_sep = ','

	else:
		sep = None
		out_sep = ' '

	#区切り文字に応じた文字列の分割
	if sep is None:
		items = line.split()
	else:
		items = [x.strip() for x in line.split(sep)]	#sepでlineを分割し、前後の空白を削除
		#空白以外の区切り文字で分割->空白での分割を実行
		#2個以上の要素に分割できたら、空白とその他の区切りが混在していると判断
		if any(len(x.split()) > 1 for x in items):
			raise NumSortError("区切り文字が統一されていません\n")
	
	return items, out_sep

def sort_nums(items, reverse=False):
	try:
		for x in items:
			if not math.isfinite(float(x)):
				raise OverflowError
		items.sort(key=float, reverse=reverse)

	except ValueError:
		raise NumSortError("数値以外のデータが含まれています\n")
	except OverflowError:
		raise NumSortError("NANやINFは扱えません\n")

	return items

def main():
	args = parse_args()
	
	try:
		items, out_sep = read_data()
		items = sort_nums(items, reverse = args.reverse)
		
		if args.delimiter is not None:
			if len(args.delimiter) != 1:
				raise NumSortError("区切り文字は1文字で指定してください\n")
			if args.delimiter in "0123456789.+-":
				raise NumSortError("数字，小数点，符号を区切り文字に指定しないでください\n")
			out_sep = args.delimiter
		
		print(out_sep.join(items))

	except NumSortError as e:
		sys.stderr.write(f"エラー：{e}")
		sys.exit(1)

if __name__ == "__main__":
	main()
