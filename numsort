import sys
import math

def read_data():
	line = sys.stdin.readline().strip()
	if not line:
		sys.stderr.write("エラー：入力データが空です\n")
		sys.exit(1)

	#区切り文字の判別
	if ';' in line:
		sep = ';'
		out_sep = ';'

	elif ',' in line:
		sep = ','
		out_sep = ','

	else:
		sep = None
		out_sep = ' '

	#区切り文字に応じた文字列の分割
	if sep is None:
		items = line.split()
	else:
		items = [x.strip() for x in line.split(sep)]
	
	return items, out_sep

def sort_nums(items):
	try:
		for x in items:
			if not math.isfinite(float(x)):
				raise OverflowError
		items.sort(key=float)

	except ValueError:
		sys.stderr.write("エラー：数値以外のデータが含まれています\n")
		sys.exit(1)
	except OverflowError:
		sys.stderr.write("エラー：NANやINFは扱えません\n")
		sys.exit(1)

	return items

def main():
	items, out_sep = read_data()
	items = sort_nums(items)

	print(out_sep.join(items))

if __name__ == "__main__":
	main()
