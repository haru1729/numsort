import sys
import argparse

def read_data(items):
	line = sys.stdin.readline().strip()
	items = line.split()
	
	return items

def sort_nums(items):
	items.sort(key=float)

	return items

def main():
	items = []

	items = read_data(items)
	items = sort_nums(items)

	print(" ".join(items))

	return

if __name__ == "__main__":
	main()
